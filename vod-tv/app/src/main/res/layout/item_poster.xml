<?xml version="1.0" encoding="utf-8"?>
<!--
  海报卡
  ─────────────────────────────────────────────────────────────
  设计要点（1.4.0 起）：
  1. 去掉旧版的「5dp 深灰卡片框」—— 卡片就是海报本身，标题浮在深色背景上。
     旧版海报被一圈框住，亮度被吃掉，6 列排开像一格格小窗。
  2. 根布局留 2dp padding，焦点描边正好落在 padding 里，不会压住海报画面。
     未聚焦时描边透明但形状一致 → 焦点切换零重排。
  3. 角标收成半透明胶囊（2 个 → 数据层只会给 1 个排名 + 1 个评分，不再有第三处）。
  4. 圆角 8dp 由 RoundImageView 用 clipPath 实现（API 19 没有 setClipToOutline）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:background="@drawable/bg_poster"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.vodtv.widget.RoundImageView
                android:id="@+id/poster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                android:background="@drawable/ph_poster"
                android:contentDescription="@null" />

            <!-- 排名角标：只有前 3 名显示，字色金/银/铜 -->
            <TextView
                android:id="@+id/rank"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_margin="@dimen/space_sm"
                android:background="@drawable/bg_pill"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 评分角标：豆瓣分数，保持金色 -->
            <TextView
                android:id="@+id/score"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_margin="@dimen/space_sm"
                android:background="@drawable/bg_pill"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingLeft="2dp"
            android:paddingRight="2dp" />

        <TextView
            android:id="@+id/sub"
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>
</FrameLayout>
