<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 触摸捕获层：SurfaceView 自带独立 surface，部分设备上直接给它绑点击收不到，
         所以用一层透明 View 兜住"点画面呼出控制栏"。
         刻意不设 focusable：这层只接手指，不参与遥控器焦点，否则焦点会停在它上面 -->
    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        tools:ignore="KeyboardInaccessibleWidget" />

    <!-- 缓冲 / 错误提示 -->
    <TextView
        android:id="@+id/msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#B3000000"
        android:padding="18dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- 控制栏 -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#D9000000"
        android:paddingLeft="40dp"
        android:paddingRight="40dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- 第一行：返回 + 片名 + 源 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/p_back"
                style="@style/PlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← 返回"
                android:nextFocusRight="@id/p_prev" />

            <TextView
                android:id="@+id/p_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="14dp"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/p_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/p_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/p_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ 控制栏 / 选集   OK 暂停   ← → 快退/快进"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 按钮行：手机上可横向滚动 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/p_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/p_prev"
                    style="@style/PlayerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上一集" />

                <TextView
                    android:id="@+id/p_rew"
                    style="@style/PlayerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快退 10 秒" />

                <TextView
                    android:id="@+id/p_play"
                    style="@style/PlayerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂停"
                    android:nextFocusRight="@id/p_ff" />

                <TextView
                    android:id="@+id/p_ff"
                    style="@style/PlayerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快进 10 秒" />

                <TextView
                    android:id="@+id/p_next"
                    style="@style/PlayerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一集" />

                <TextView
                    android:id="@+id/p_eps"
                    style="@style/PlayerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选集" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 选集浮层：盖住控制栏，选中直接切集，播放不中断 -->
    <LinearLayout
        android:id="@+id/ep_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ep_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选集"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ep_close"
                style="@style/PlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关闭" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ep_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
