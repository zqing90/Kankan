<?xml version="1.0" encoding="utf-8"?>
<!--
  播放页
  ─────────────────────────────────────────────────────────────
  控制栏三层：
    ① 信息行：返回 · 片名 · 当前片源胶囊
    ② 进度行：细进度条 + 左右时间码（等宽字体，跳秒不会让数字左右晃）
    ③ 按钮行：居中的图标组，播放键是唯一的蓝色圆形实底
  底部用渐变而不是整块黑条，画面不会被压掉一大截。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 触摸捕获层：SurfaceView 自带独立 surface，部分设备上直接给它绑点击收不到，
         所以用一层透明 View 兜住「点画面呼出控制栏」。
         刻意不设 focusable：这层只接手指，不参与遥控器焦点，否则焦点会停在它上面 -->
    <View
        android:id="@+id/touch_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        tools:ignore="KeyboardInaccessibleWidget" />

    <!-- 缓冲 / 错误提示 -->
    <TextView
        android:id="@+id/msg"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- 长按快进/快退的反馈浮层：连续跳的时候画面一直在跳，
         没有文字提示就不知道到底跳了多少、跳到哪了。
         刻意不设 clickable/focusable：这层只负责显示，不能挡住下面 touch_layer 的手指事件 -->
    <LinearLayout
        android:id="@+id/seek_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_panel"
        android:paddingLeft="@dimen/space_xl"
        android:paddingRight="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg"
        android:visibility="gone">

        <TextView
            android:id="@+id/seek_hud_action"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/seek_hud_time"
            style="@style/Text.Micro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- ============ 控制栏 ============ -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_player_controls"
        android:paddingLeft="@dimen/topbar_pad_h"
        android:paddingRight="@dimen/topbar_pad_h"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl"
        android:visibility="gone">

        <!-- ① 信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/p_back"
                style="@style/PlayerIconBtn"
                android:src="@drawable/ic_ui_back"
                android:contentDescription="@string/back"
                android:nextFocusRight="@id/p_prev" />

            <TextView
                android:id="@+id/p_title"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="@dimen/space_md" />

            <TextView
                android:id="@+id/p_source"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- ② 进度行 -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/space_lg"
            android:max="1000"
            android:progressDrawable="@drawable/progress_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                android:id="@+id/p_time"
                style="@style/Text.Micro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/p_hint"
                style="@style/Text.Micro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_hint" />
        </LinearLayout>

        <!-- ③ 按钮行：整组居中，播放键在这组里唯一有实底。
             fillViewport=true + 子布局 wrap_content：宽度够时居中，
             不够时（窄屏加标签后可能超出）从左排、可横向滚动，
             不会像 layout_gravity=center_horizontal 那样两头对称截掉。 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/p_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/p_prev"
                    style="@style/PlayerIconBtn"
                    android:src="@drawable/ic_ui_prev"
                    android:contentDescription="@string/prev_episode" />

                <!-- 快退/快进带中文标签：Material 的 replay_10/forward_10 在 24dp 下
                     里面那个「10」只有 4dp 高，实际屏幕上就是两个「旋转箭头」，
                     用户根本认不出是快进快退（1.4.4 收到的反馈就是这个）。 -->
                <LinearLayout
                    android:id="@+id/p_rew"
                    style="@style/PlayerSeekBtn"
                    android:contentDescription="@string/rewind_10">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ui_replay10"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/rewind_short"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/p_play"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginLeft="@dimen/space_sm"
                    android:layout_marginRight="@dimen/space_sm"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_play"
                    android:src="@drawable/ic_ui_pause"
                    android:contentDescription="@string/pause"
                    android:focusable="true"
                    android:nextFocusRight="@id/p_ff" />

                <LinearLayout
                    android:id="@+id/p_ff"
                    style="@style/PlayerSeekBtn"
                    android:contentDescription="@string/forward_10">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ui_forward10"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Text.Micro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/forward_short"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/p_next"
                    style="@style/PlayerIconBtn"
                    android:src="@drawable/ic_ui_next"
                    android:contentDescription="@string/next_episode" />

                <ImageView
                    android:id="@+id/p_eps"
                    style="@style/PlayerIconBtn"
                    android:src="@drawable/ic_ui_episodes"
                    android:contentDescription="@string/episodes" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ============ 选集浮层 ============ -->
    <LinearLayout
        android:id="@+id/ep_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="@dimen/space_xxl"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/space_xl"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ep_title"
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/episodes" />

            <TextView
                android:id="@+id/ep_close"
                style="@style/PlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_lg"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ep_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
