<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶栏：左上返回 + 输入框 + 搜索图标（与其他二级页同一套结构） -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/topbar_pad_h"
        android:paddingRight="@dimen/topbar_pad_h"
        android:paddingTop="20dp"
        android:paddingBottom="6dp">

        <include
            android:id="@+id/btn_back"
            layout="@layout/part_back" />

        <EditText
            android:id="@+id/q"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:background="@drawable/bg_tab"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_dim"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_go"
            style="@style/IconButton"
            android:src="@drawable/ic_ui_search"
            android:contentDescription="@string/search" />
    </LinearLayout>

    <!-- 最近搜索：只在还没输入关键词时显示 -->
    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topbar"
        android:orientation="vertical"
        android:paddingLeft="@dimen/content_pad_h"
        android:paddingRight="@dimen/topbar_pad_h"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_history"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_history_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:background="@drawable/bg_tab"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/history_clear"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 标签按行动态填：代码里每行最多放 6 个 -->
        <LinearLayout
            android:id="@+id/history_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- 状态 / 兜底入口 -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/history_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/content_pad_h"
        android:paddingRight="@dimen/topbar_pad_h"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="输入片名后按搜索图标，也可以直接按遥控器确认键"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- 本地榜单没有时才出现：去 14 个片源站搜 -->
        <TextView
            android:id="@+id/btn_online"
            style="@style/TopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="联网搜索片源"
            android:visibility="gone" />
    </LinearLayout>

    <GridView
        android:id="@+id/sgrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/status_bar"
        android:layout_alignParentBottom="true"
        android:numColumns="6"
        android:horizontalSpacing="14dp"
        android:verticalSpacing="20dp"
        android:paddingLeft="@dimen/content_pad_h"
        android:paddingRight="@dimen/content_pad_h"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />
</RelativeLayout>
