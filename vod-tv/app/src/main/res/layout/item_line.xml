<?xml version="1.0" encoding="utf-8"?>
<!-- 播放线路一行：线路名 + 规格 + 可用徽标 + 历史表现 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:background="@drawable/bg_card"
    android:paddingLeft="@dimen/space_lg"
    android:paddingRight="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/line_name"
        style="@style/Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/line_spec"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_md" />

    <TextView
        android:id="@+id/line_badge"
        style="@style/Text.Micro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_md"
        android:background="@drawable/bg_chip"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/green"
        android:visibility="gone" />

    <TextView
        android:id="@+id/line_stat"
        style="@style/Text.Micro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_md" />
</LinearLayout>
