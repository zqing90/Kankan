<?xml version="1.0" encoding="utf-8"?>
<!-- 片源站一行：序号 + 站名/域名 + 统计 + 可用状态胶囊 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:background="@drawable/bg_card"
    android:paddingLeft="@dimen/space_lg"
    android:paddingRight="@dimen/space_lg"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md"
    android:layout_marginBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/src_index"
        style="@style/Text.Micro"
        android:layout_width="28dp"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/src_name"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/src_host"
            style="@style/Text.Micro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle" />
    </LinearLayout>

    <TextView
        android:id="@+id/src_stat"
        style="@style/Text.Micro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_md"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/src_state"
        style="@style/Text.Micro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_md"
        android:background="@drawable/bg_chip"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/green" />
</LinearLayout>
