<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:paddingTop="22dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginRight="28dp" />

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_search"
            style="@style/TopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search" />

        <TextView
            android:id="@+id/btn_refresh"
            style="@style/TopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/refresh"
            android:nextFocusDown="@id/grid" />

        <TextView
            android:id="@+id/btn_settings"
            style="@style/TopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:nextFocusDown="@id/grid" />
    </LinearLayout>

    <!-- 数据源 / 更新时间 -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topbar"
        android:paddingLeft="38dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:text="@string/loading"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <!-- 继续观看：无历史时整块 gone，GridView 会自动贴回 status 下方 -->
    <LinearLayout
        android:id="@+id/history_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/status"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="38dp"
            android:paddingBottom="8dp"
            android:text="继续观看"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/history_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/history_block"
        android:layout_alignParentBottom="true"
        android:numColumns="6"
        android:horizontalSpacing="14dp"
        android:verticalSpacing="20dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none"
        android:nextFocusUp="@id/tabs" />

    <!-- 空态 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/empty"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />
</RelativeLayout>
