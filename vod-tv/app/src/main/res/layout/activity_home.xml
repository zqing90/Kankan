<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/topbar_pad_h"
        android:paddingRight="@dimen/topbar_pad_h"
        android:paddingTop="22dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/app_title_size"
            android:textStyle="bold"
            android:layout_marginRight="28dp" />

        <!-- 分类 tab 放进横向滚动并吃掉剩余宽度：
             窄屏（手机）上 6 个 tab + 4 个图标按钮会溢出，图标被挤出屏幕就点不到了 -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 动作一律用图标（Material Icons），顺序固定：搜索 / 记录 / 更新 / 设置 -->
        <ImageView
            android:id="@+id/btn_search"
            style="@style/IconButton"
            android:src="@drawable/ic_ui_search"
            android:contentDescription="@string/search" />

        <ImageView
            android:id="@+id/btn_history"
            style="@style/IconButton"
            android:src="@drawable/ic_ui_history"
            android:contentDescription="@string/history"
            android:nextFocusDown="@id/grid" />

        <ImageView
            android:id="@+id/btn_refresh"
            style="@style/IconButton"
            android:src="@drawable/ic_ui_refresh"
            android:contentDescription="@string/refresh"
            android:nextFocusDown="@id/grid" />

        <ImageView
            android:id="@+id/btn_settings"
            style="@style/IconButton"
            android:src="@drawable/ic_ui_settings"
            android:contentDescription="@string/settings"
            android:nextFocusDown="@id/grid" />
    </LinearLayout>

    <!-- 数据源 / 更新时间 -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topbar"
        android:paddingLeft="@dimen/content_pad_h"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:text="@string/loading"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <!-- 继续观看：无历史时整块 gone，GridView 会自动贴回 status 下方 -->
    <LinearLayout
        android:id="@+id/history_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/status"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/history_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/content_pad_h"
            android:paddingBottom="8dp"
            android:text="继续观看"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/content_pad_h"
            android:paddingRight="@dimen/content_pad_h"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/history_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/history_block"
        android:layout_alignParentBottom="true"
        android:numColumns="6"
        android:horizontalSpacing="14dp"
        android:verticalSpacing="20dp"
        android:paddingLeft="@dimen/content_pad_h"
        android:paddingRight="@dimen/content_pad_h"
        android:paddingTop="8dp"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none"
        android:nextFocusUp="@id/tabs" />

    <!-- 空态 -->
    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/empty"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone" />
</RelativeLayout>
