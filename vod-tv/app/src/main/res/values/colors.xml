<?xml version="1.0" encoding="utf-8"?>
<!--
  设计 token：颜色
  ─────────────────────────────────────────────────────────────
  规则（改色前先读这段，不要临时加新色值）：
  1. 强调色只有一个 —— brand #2B5CFF，与 App 图标同值，保证「桌面 → 应用」品牌连续。
     旧版界面用粉红 #FF4D6A，和蓝底图标完全对不上，已废弃。
  2. 语义色只给语义用：gold 评分 / green 可播 / red 失败 / amber 警告。
  3. 文本只用 text_primary / text_secondary / text_tertiary 三档。
  4. 对比度（对着 bg #08090D）：
       text_primary 18.4:1 ｜ text_secondary 7.6:1 ｜ text_tertiary 5.0:1  → 三档均过 WCAG AA。
       旧值 text_dim #5F6878 只有 3.4:1，11sp 提示文字在电视上根本看不清，已废弃。
-->
<resources>

    <!-- 背景层次：三档必须互相看得出差别，否则「哪里是卡片」会糊成一片 -->
    <color name="bg">#FF08090D</color>
    <color name="surface">#FF12151C</color>
    <color name="surface_2">#FF1B1F28</color>

    <!-- 描边：12% 白是分隔线，20% 白是面板外框 -->
    <color name="stroke">#1FFFFFFF</color>
    <color name="stroke_strong">#33FFFFFF</color>

    <!-- 品牌色：与 ic_launcher_bg 同值，不要分别调 -->
    <color name="brand">#FF2B5CFF</color>
    <color name="brand_dim">#FF1F47D6</color>
    <!-- 焦点描边比品牌色亮一档，深底上主体更清楚 -->
    <color name="focus">#FF5B82FF</color>

    <!-- 文本三档 -->
    <color name="text_primary">#FFF5F7FA</color>
    <color name="text_secondary">#FF9BA4B4</color>
    <color name="text_tertiary">#FF76808F</color>

    <!-- 语义色 -->
    <color name="gold">#FFFFC94D</color>
    <color name="silver">#FFC0C8D4</color>
    <color name="bronze">#FFCD7F32</color>
    <color name="green">#FF3DDC97</color>
    <color name="amber">#FFFFB020</color>
    <color name="red">#FFFF4D4D</color>

    <!-- 半透明遮罩：角标、浮层底 -->
    <color name="scrim">#B3000000</color>
    <color name="scrim_light">#80000000</color>

    <!-- 自适应图标底色（与 brand 同值，避免圆角遮罩下露白） -->
    <color name="ic_launcher_bg">#FF2B5CFF</color>
</resources>
