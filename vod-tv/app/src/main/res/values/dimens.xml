<?xml version="1.0" encoding="utf-8"?>
<!--
  设计 token：尺寸与字号（手机 / 小屏，宽 < 600dp）
  ─────────────────────────────────────────────────────────────
  字号只有 5 档，不许再写 13.5sp、15.5sp 这种散装值：
    text_hero 26  → App 名、详情页片名
    text_title 20 → 区块标题、页面标题
    text_body 15  → 卡片标题、列表主行
    text_caption 13 → 卡片副标题、次要信息
    text_micro 11 → 角标、时间码、提示
  电视档（values-sw600dp）整体放大一级，同一份布局两边都能用。
-->
<resources>
    <dimen name="topbar_pad_h">20dp</dimen>
    <dimen name="content_pad_h">16dp</dimen>

    <dimen name="text_hero">26sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_body">15sp</dimen>
    <dimen name="text_caption">13sp</dimen>
    <dimen name="text_micro">11sp</dimen>

    <dimen name="app_title_size">20sp</dimen>
    <dimen name="icon_btn_size">40dp</dimen>
    <dimen name="card_gap_h">10dp</dimen>
    <dimen name="card_gap_v">16dp</dimen>

    <!-- 圆角四档：海报/卡片 md，浮层 lg，对话框 xl，小标签 sm。
         旧版是 0 / 6 / 8 / 14 四个没有规律的值，已统一。 -->
    <dimen name="radius_sm">4dp</dimen>
    <dimen name="radius_md">8dp</dimen>
    <dimen name="radius_lg">12dp</dimen>
    <dimen name="radius_xl">16dp</dimen>

    <!-- 间距：4 的倍数，只有这六档 -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>

    <!-- 焦点描边：全应用只有 2dp 这一个值 -->
    <dimen name="focus_stroke">2dp</dimen>
</resources>
