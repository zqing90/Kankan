<?xml version="1.0" encoding="utf-8"?>
<!--
  分类 tab。未选中完全透明（流媒体导航惯例：不给底板，只靠文字颜色区分），
  选中 = 品牌蓝实底白字，焦点 = 有实底再加白色描边，没实底就加蓝色描边。
  ★ 选中 + 焦点同时成立时用白描边，因为蓝底 + 蓝描边会糊成一坨。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
