<?xml version="1.0" encoding="utf-8"?>
<!--
  统一的「面」：列表行、线路卡、面板卡都用它。
  ★ 全项目只有这一处定义焦点视觉 —— 焦点一律是「2dp 品牌蓝描边 + 提亮一档的底」。
    1.3.x 及更早有两套：卡片用 3dp 白边、按钮用 2dp 粉边，同一屏里两种焦点框，
    用户能明显感觉到「不统一」。白色 3dp 在深色海报上还会刺眼，已废弃。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
