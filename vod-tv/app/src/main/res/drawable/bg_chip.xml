<?xml version="1.0" encoding="utf-8"?>
<!--
  胶囊控件：搜索历史标签、集数格、状态徽标。
  选中态 = 品牌蓝实底（用来标「当前正在播的这一集」），焦点沿用统一 2dp 蓝描边。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="99dp" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="99dp" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_2" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="99dp" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</selector>
