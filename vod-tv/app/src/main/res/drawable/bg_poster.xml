<?xml version="1.0" encoding="utf-8"?>
<!--
  海报卡的底。关键设计：底色永远是透明的，只画描边。
  外面套 2dp padding，描边正好落在 padding 区域里，不会压住海报画面一角。
  未聚焦时描边透明但形状一致 → 焦点切换只改颜色，不引起任何重排/抖动。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
